@*
    <auto-generated-by-scaffold />

    The search panel is the same explicit EditorFor lines as the form, so it
    renders on templates that already exist. Range filters are paired nullable
    scalars (FromTo), not a new complex type, so no editor template was added.
*@
@model {{ viewModelNamespace }}.{{ indexModel.className }}
@{
    ViewData["Title"] = "{{ entity.pluralTitle }}";

    var search = Model.Search;
    var route = search.ToRouteValues();

    // Declared once and looped: a quoted string literal inside a quoted
    // attribute value is not parseable by Razor.
    var sortColumns = new (string Key, string Label)[]
    {
{{~ for c in listItemModel.columns ~}}
        ("{{ c.sortKey }}", "{{ c.displayName }}"){{ if !for.last }},{{ end }}
{{~ end ~}}
    };

    // Same column flips direction; a new column starts ascending.
    Dictionary<string, string?> SortRoute(string key)
    {
        var values = new Dictionary<string, string?>(route);
        var active = string.Equals(search.Sort, key, StringComparison.OrdinalIgnoreCase);
        values["Sort"] = key;
        values["Desc"] = active && !search.Desc ? "true" : null;
        values.Remove("Page");
        return values;
    }

    string SortIndicator(string key) =>
        string.Equals(search.Sort, key, StringComparison.OrdinalIgnoreCase)
            ? (search.Desc ? "▼" : "▲")
            : string.Empty;

    Dictionary<string, string?> PageRoute(int page) =>
        new(route) { ["Page"] = page.ToString() };
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">{{ entity.pluralTitle }}</h1>
    <a asp-action="Create" class="btn btn-primary">New {{ entity.titleLower }}</a>
</div>
{{~ if searchModel.any }}

<form method="get" asp-action="Index" class="card card-body bg-body-tertiary mb-4">
    @* Paging state travels as hidden fields; a new search starts on page 1. *@
    <input type="hidden" name="Sort" value="@search.Sort" />
    <input type="hidden" name="Desc" value="@search.Desc.ToString().ToLowerInvariant()" />
    <input type="hidden" name="PageSize" value="@search.PageSize" />

    <div class="row g-3">
{{~ for f in searchModel.fields }}
        <div class="col-12 col-md-6 col-lg-4">
{{~ if f.staticChoices }}
            @Html.EditorFor(m => m.Search.{{ f.name }}, new { items = {{ searchModel.className }}.{{ f.staticChoices }} })
{{~ else if f.itemsProperty }}
            @Html.EditorFor(m => m.Search.{{ f.name }}, new { items = search.{{ f.itemsProperty }}, placeholder = "{{ f.placeholder }}" })
{{~ else }}
            @Html.EditorFor(m => m.Search.{{ f.name }})
{{~ end }}
        </div>
{{~ end }}
    </div>

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary">Search</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Reset</a>
    </div>
</form>
{{~ end }}

<div class="d-flex justify-content-between align-items-center mb-2">
    <span class="text-muted small">
        @if (Model.TotalCount == 0)
        {
            <text>No matching {{ entity.pluralTitle | string.downcase }}.</text>
        }
        else
        {
            <text>Showing @Model.FirstRowOnPage&ndash;@Model.LastRowOnPage of @Model.TotalCount</text>
        }
    </span>
</div>

<div class="table-responsive">
    <table class="table table-sm table-hover align-middle">
        <thead>
            <tr>
            @foreach (var col in sortColumns)
            {
                <th>
                    <a asp-action="Index" asp-all-route-data="SortRoute(col.Key)" class="text-decoration-none">
                        @col.Label @SortIndicator(col.Key)
                    </a>
                </th>
            }
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var item in Model.Items)
        {
            <tr>
{{~ for c in listItemModel.columns }}
{{~ if c.isBool }}
                <td>
                    @if (item.{{ c.name }})
                    {
                        <span class="badge text-bg-success">Yes</span>
                    }
                    else
                    {
                        <span class="badge text-bg-secondary">No</span>
                    }
                </td>
{{~ else if c.isDate && c.nullable }}
                <td>@(item.{{ c.name }}?.ToString("g") ?? "—")</td>
{{~ else if c.isDate }}
                <td>@item.{{ c.name }}.ToString("g")</td>
{{~ else }}
                <td>@item.{{ c.name }}</td>
{{~ end }}
{{~ end }}
                <td class="text-end">
                    <div class="btn-group btn-group-sm">
                        <a asp-action="Details" {{ controller.key.routeAttributesForItem }} class="btn btn-outline-secondary">Details</a>
                        <a asp-action="Edit" {{ controller.key.routeAttributesForItem }} class="btn btn-outline-secondary">Edit</a>
                        <a asp-action="Delete" {{ controller.key.routeAttributesForItem }} class="btn btn-outline-danger">Delete</a>
                    </div>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>

@if (Model.TotalPages > 1)
{
    <nav aria-label="{{ entity.pluralTitle }} pages">
        <ul class="pagination pagination-sm">
            <li class="page-item @(Model.HasPrevious ? "" : "disabled")">
                <a class="page-link" asp-action="Index" asp-all-route-data="PageRoute(Model.Page - 1)">Previous</a>
            </li>
            <li class="page-item disabled">
                <span class="page-link">Page @Model.Page of @Model.TotalPages</span>
            </li>
            <li class="page-item @(Model.HasNext ? "" : "disabled")">
                <a class="page-link" asp-action="Index" asp-all-route-data="PageRoute(Model.Page + 1)">Next</a>
            </li>
        </ul>
    </nav>
}

@*
    <auto-generated-by-scaffold />

    Explicit EditorFor per property rather than EditorForModel(): Dropdown reads
    ViewData["items"], and additionalViewData is scoped to a single EditorFor
    call, so one EditorForModel() cannot hand different options to different
    properties. This shape also leaves field order and layout editable.
*@
@model {{ viewModelNamespace }}.{{ model.className }}
@{
    ViewData["Title"] = "{{ pageTitle }}";
}

<h1 class="h3">{{ pageTitle }}</h1>

<form method="post" asp-action="{{ formAction }}"{{ if model.includeKey }} {{ controller.key.routeAttributesForModel }}{{ end }}>
    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>
{{~ if model.includeKey }}
{{~ for k in model.keys }}

    <input type="hidden" asp-for="{{ k.name }}" />
{{~ end }}
{{~ end }}
{{~ if model.concurrencyToken }}
    <input type="hidden" asp-for="{{ model.concurrencyToken }}" />
{{~ end }}

    <div class="row g-3">
{{~ for f in model.fields }}
        <div class="col-12 col-md-6">
{{~ if f.itemsProperty }}
            @Html.EditorFor(m => m.{{ f.name }}, new { items = Model.{{ f.itemsProperty }}, placeholder = "{{ f.placeholder }}" })
{{~ else }}
            @Html.EditorFor(m => m.{{ f.name }})
{{~ end }}
        </div>
{{~ end }}
    </div>

    <div class="d-flex gap-2 mt-3">
        <button type="submit" class="btn btn-primary">Save</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

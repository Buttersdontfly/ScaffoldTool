// <auto-generated-by-scaffold />
// Regenerate with: scaffold generate --from model.json --entity {{ entity.name }} --force
// Hand edits are lost. The class is partial: put customisation in a separate
// file such as {{ model.className }}.Custom.cs, or edit model.json.

// Roslyn treats a file whose first comment contains <auto-generated as generated
// code and disables the nullable context in it, whatever the project setting.
// Without this directive every string? below is CS8632.
#nullable enable

using System.ComponentModel.DataAnnotations;
using Microsoft.AspNetCore.Mvc.ModelBinding;
using Microsoft.AspNetCore.Mvc.ModelBinding.Validation;
using Microsoft.AspNetCore.Mvc.Rendering;

namespace {{ viewModelNamespace }};

public partial class {{ model.className }}
{
{{~ if model.includeKey ~}}
    // Rendered as hidden fields so the POST can identify the row. The controller
    // still reloads from the route values and compares.
{{~ for k in model.keys ~}}
    public {{ k.csType }} {{ k.name }} { get; set; }
{{~ end ~}}

{{~ end ~}}
{{~ for f in model.fields ~}}
{{~ for t in f.todos ~}}
    // {{ t }}
{{~ end ~}}
{{~ for a in f.attributes ~}}
    [{{ a }}]
{{~ end ~}}
    public {{ f.csType }} {{ f.name }} { get; set; }{{ f.initializer }}

{{~ end ~}}
{{~ if model.concurrencyToken ~}}
    // Concurrency token. Round-tripped as a hidden field; SaveChanges throws
    // DbUpdateConcurrencyException if another write landed first.
    [Timestamp]
    public byte[]? {{ model.concurrencyToken }} { get; set; }

{{~ end ~}}
{{~ if model.itemsProperties.size > 0 ~}}
    // Options for the Dropdown templates, filled by {{ entity.controller }}.
    // [BindNever] stops a crafted post stuffing these; [ValidateNever] keeps the
    // validator from walking into SelectListItem.
{{~ for i in model.itemsProperties ~}}

    [BindNever, ValidateNever]
    public IEnumerable<SelectListItem> {{ i }} { get; set; } = [];
{{~ end ~}}
{{~ end ~}}
}

        catch (DbUpdateException)
        {
            // Reached when a restricting foreign key blocks the delete.
            ModelState.AddModelError(string.Empty, "This {{ entity.titleLower }} is still referenced elsewhere and could not be deleted.");

            var vm = await ProjectToDetailsAsync({{ controller.key.arguments }}, ct);

            return vm is null ? RedirectToAction(Actions.Index) : View(vm);
        }

        return RedirectToAction(Actions.Index);
    }


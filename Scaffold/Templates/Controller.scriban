        var {{ m.variable }}Existing = entity.{{ m.navigation }}.Select(x => x.{{ m.targetKey }}).ToHashSet();
        var {{ m.variable }}ToAdd = {{ m.variable }}Selected.Where(id => !{{ m.variable }}Existing.Contains(id)).ToList();


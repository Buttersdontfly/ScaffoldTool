    [HttpPost]
    [ValidateAntiForgeryToken]
    public async Task<IActionResult> DeleteAsync({{ controller.key.parameters }}, CancellationToken ct)
    {
        var entity = await _context.{{ controller.dbSet }}.FirstOrDefaultAsync(x => {{ controller.key.predicate }}, ct);

        if (entity is null)
        {
            // Already gone. A double submit is success, not a 404.
            return RedirectToAction(Actions.Index);
        }

        _context.{{ controller.dbSet }}.Remove(entity);

        try
        {
            await _context.SaveChangesAsync(ct);

@*  <auto-generated-by-scaffold />  *@
@model {{ viewModelNamespace }}.{{ detailsModel.className }}
@{
    ViewData["Title"] = "Delete {{ entity.titleLower }}";
}

<h1 class="h3">Delete {{ entity.titleLower }}</h1>

<div class="alert alert-warning">
    This cannot be undone. Are you sure you want to delete this {{ entity.titleLower }}?
</div>
{{~ if detailsModel.hasCascades }}

@{
    var cascaded = new (int Count, string Label)[]
    {
{{~ for c in detailsModel.cascades ~}}
        (Model.{{ c.name }}, "{{ c.label }}"){{ if !for.last }},{{ end }}
{{~ end ~}}
    };
    var totalCascaded = cascaded.Sum(c => c.Count);
}

@if (totalCascaded > 0)
{
    @* The foreign keys cascade, so the database deletes these rows silently.
       Saying "cannot be undone" without a number is not a warning. *@
    <div class="alert alert-danger">
        <strong>Deleting this also deletes:</strong>
        <ul class="mb-0">
            @foreach (var entry in cascaded.Where(c => c.Count > 0))
            {
                <li>@entry.Count @entry.Label</li>
            }
        </ul>
    </div>
}
{{~ end }}

<div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

<dl class="row">
{{~ for f in detailsModel.fields }}
    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.{{ f.name }})</dt>
{{~ if f.isList }}
    <dd class="col-sm-9">@(Model.{{ f.name }}.Count == 0 ? "—" : string.Join(", ", Model.{{ f.name }}))</dd>
{{~ else if f.isDate && f.nullable }}
    <dd class="col-sm-9">@(Model.{{ f.name }}?.ToString("g") ?? "—")</dd>
{{~ else if f.isDate }}
    <dd class="col-sm-9">@Model.{{ f.name }}.ToString("g")</dd>
{{~ else }}
    <dd class="col-sm-9">@Model.{{ f.name }}</dd>
{{~ end }}
{{~ end }}
</dl>

<form method="post" asp-action="Delete" {{ controller.key.routeAttributesForModel }}>
    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
    </div>
</form>

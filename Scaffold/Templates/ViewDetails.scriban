@*
    <auto-generated-by-scaffold />

    Plain markup rather than DisplayFor: the project ships EditorTemplates only,
    so DisplayFor would fall back to MVC's built-in defaults, which do not match
    this styling. Set "useDisplayTemplates": true in model.json once a
    DisplayTemplates folder exists.
*@
@model {{ viewModelNamespace }}.{{ detailsModel.className }}
@{
    ViewData["Title"] = "{{ entity.title }}";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">{{ entity.title }}</h1>
    <div class="d-flex gap-2">
        <a asp-action="Edit" {{ controller.key.routeAttributesForModel }} class="btn btn-outline-secondary">Edit</a>
        <a asp-action="Delete" {{ controller.key.routeAttributesForModel }} class="btn btn-outline-danger">Delete</a>
    </div>
</div>

<dl class="row">
{{~ for f in detailsModel.fields }}
    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.{{ f.name }})</dt>
{{~ if f.isList }}
    <dd class="col-sm-9">@(Model.{{ f.name }}.Count == 0 ? "—" : string.Join(", ", Model.{{ f.name }}))</dd>
{{~ else if f.isBool }}
    <dd class="col-sm-9">
        @if (Model.{{ f.name }})
        {
            <span class="badge text-bg-success">Yes</span>
        }
        else
        {
            <span class="badge text-bg-secondary">No</span>
        }
    </dd>
{{~ else if f.isDate && f.nullable }}
    <dd class="col-sm-9">@(Model.{{ f.name }}?.ToString("g") ?? "—")</dd>
{{~ else if f.isDate }}
    <dd class="col-sm-9">@Model.{{ f.name }}.ToString("g")</dd>
{{~ else }}
    <dd class="col-sm-9">@Model.{{ f.name }}</dd>
{{~ end }}
{{~ end }}
</dl>
{{~ for c in controller.collections }}
{{~ if c.targetRoute }}

@* TODO(scaffold): {{ c.name }} is a collection navigation. Linked to the child
   list filtered by this row rather than rendered as an inline table; inline add
   and remove needs index handling that is not generated. *@
<a asp-controller="{{ c.targetRoute }}" asp-action="Index" {{ controller.key.routeAttributesForModel }} class="btn btn-sm btn-outline-secondary">
    View {{ c.label }}
</a>
{{~ end }}
{{~ end }}

<div class="mt-3">
    <a asp-action="Index" class="btn btn-link px-0">Back to list</a>
</div>
